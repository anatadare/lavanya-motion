{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motion-prompt-bot",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ekstrak frame dari video (Media Transformations)
  "media": { "binding": "MEDIA" },

  // pipeline panjang (download -> analisis per bagian -> tulis prompt) jalan di Workflow
  "workflows": [
    {
      "name": "motion-prompt-pipeline",
      "binding": "PIPELINE",
      "class_name": "MotionPipeline"
    }
  ],

  // non-rahasia. Rahasia (token/key) diisi lewat dashboard sebagai Secret
  "vars": {
    "VISION_MODELS": "claude-sonnet-4-6,grok-4.7,qwen3.8-27b",
    "TEXT_MODELS": "claude-sonnet-4-6,nemotron-3-ultra,qwen3.7-plus",
    "MAX_DURATION": "30",      // detik, video lebih panjang ditolak
    "SEGMENT_SECONDS": "5",    // video dipecah per bagian segini detik (= panjang 1 clip hasil)
    "FRAME_INTERVAL": "",      // detik antar frame. Kosong = otomatis (0.5s utk <=10s, 0.75s utk <=20s, 1s utk >20s)
    "FRAME_WIDTH": "768",
    "ALLOWED_USER_IDS": ""
  }
}
